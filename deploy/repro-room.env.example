# Repro Room control-plane configuration (systemd EnvironmentFile).
# Installed as /etc/repro-room/repro-room.env, mode 0640 root:reproroom. Never commit real values.

# --- LLM: Vultr Serverless Inference (OpenAI-compatible) ---
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3
LLM_TIMEOUT=120

# --- GitHub (optional): fine-grained, read-only, public repositories. Unauthenticated works (60 requests/hour). ---
GITHUB_TOKEN=

# --- Sandbox ---
SANDBOX_RUNTIME_CLI=docker
# runsc = gVisor (setup-vm.sh --gvisor sets this); empty = Docker's default runtime (runc)
SANDBOX_OCI_RUNTIME=
SANDBOX_IMAGE=docker.io/library/python:3.12-slim
SANDBOX_INIT=1
SANDBOX_RUN_TIMEOUT=60
SANDBOX_FETCH_TIMEOUT=180
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128
SANDBOX_OUTPUT_CAP=262144

# --- Storage (must be a real host path: dockerd resolves bind mounts outside the service's PrivateTmp) ---
DATA_DIR=/var/lib/repro-room
WORK_ROOT=/var/lib/repro-room/work
SELF_URL=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000

# --- Public demo abuse limits ---
MAX_QUEUE=5
RATE_LIMIT_PER_IP=4
RATE_LIMIT_WINDOW=3600
DAILY_JOB_CAP=60
